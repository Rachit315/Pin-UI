# Copy to .env.local for `npm run dev`. On Vercel, set the same three under
# Project Settings → Environment Variables (Production and Preview).
# SUPABASE_PUBLISHABLE_KEY is read on the server only — never prefix it with
# NEXT_PUBLIC_.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

NEXT_PUBLIC_SITE_URL=https://pinui.xyz
