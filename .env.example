# Copy to .env.local for `npm run dev`, and to .dev.vars for `npm run preview`
# (the local Cloudflare worker). In production, SUPABASE_URL and
# NEXT_PUBLIC_SITE_URL are vars in wrangler.jsonc, and SUPABASE_PUBLISHABLE_KEY
# is a secret on the worker (dashboard → Settings → Variables and secrets).

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

NEXT_PUBLIC_SITE_URL=https://pinui.xyz
