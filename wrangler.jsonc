/**
 * The Cloudflare Worker that serves pinui.xyz, built by OpenNext.
 *
 * Pushes to `main` are built and deployed by Workers Builds, which is
 * connected to this repository. The Supabase key is a secret set in the
 * dashboard (Settings → Variables and secrets), never written here.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pin-ui",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      /* lets the worker call itself, which OpenNext's caching relies on */
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pin-ui"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://pinui.xyz",
    "SUPABASE_URL": "https://jaiclhpjldjewzlrxkcp.supabase.co"
  },
  "observability": {
    "enabled": true
  }
}
